# Copy to .env.local and fill in from Supabase → Project Settings → API.
# .env.local is git-ignored. Never commit real keys.

# Safe to expose to the browser — RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Bypasses RLS entirely — used for sending staff invites.
# Never prefix this with NEXT_PUBLIC_ and never reference it in a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where invite and password-reset links come back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Phase 4). Without these, forms can be filled in and signed but not
# sent. Sign up at resend.com, verify zionvocrehab.com, and create an API key.
RESEND_API_KEY=re_your_key
EMAIL_FROM=Zion Vocational Rehabilitation Center <service@zionvocrehab.com>

# Shared secret protecting /api/cron/notify. Generate with:
#   node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"base64url\"))"
CRON_SECRET=generate-a-long-random-value
