# Copy to .env.local and fill in from Supabase → Project Settings → API.
# .env.local is git-ignored. Never commit real keys.

# Safe to expose to the browser — RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Bypasses RLS entirely — used for sending staff invites.
# Never prefix this with NEXT_PUBLIC_ and never reference it in a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where invite and password-reset links come back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
